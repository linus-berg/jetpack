# Optional: terminate TLS in nginx instead of in Jetpack itself.
# Jetpack then only needs plain HTTP on 8080 (no certificate settings).
# All URLs Jetpack emits are relative, so no extra rewriting is needed.

server {
    listen 443 ssl;
    http2 on;
    server_name plugins.jetbrains.com downloads.marketplace.jetbrains.com jetpack.corp.example;

    ssl_certificate     /etc/nginx/certs/jetpack.crt;
    ssl_certificate_key /etc/nginx/certs/jetpack.key;

    # Plugin uploads can be large; stream them straight through.
    client_max_body_size 2g;
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://jetpack:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }
}
