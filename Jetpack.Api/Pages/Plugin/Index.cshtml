@page "/plugin/index"
@using Jetpack.Api.Endpoints
@model IndexModel

@if (Model.Plugin == null) {
    <div class="jp-empty card">
        <div class="card-body text-center py-5">
            <div class="jp-empty-icon mb-2">@Icons.Render("alert", "jp-icon jp-icon-xl")</div>
            <h1 class="h4">Plugin not found</h1>
            <p class="text-body-secondary">
                @if (Model.RequestedId != null) {
                    <text>Plugin <code>@Model.RequestedId</code> is not available on this server.</text>
                } else {
                    <text>No plugin ID was given.</text>
                }
            </p>
            <a class="btn btn-primary" asp-page="/Index">@Icons.Render("arrow-left") All plugins</a>
        </div>
    </div>
    return;
}

@{
    PluginEntry plugin = Model.Plugin;
    PluginRelease latest = Model.Latest;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-page="/Index">Plugins</a></li>
        <li class="breadcrumb-item active text-truncate" aria-current="page">@plugin.Name</li>
    </ol>
</nav>

<section class="card jp-plugin-header mb-4">
    <div class="card-body d-flex flex-wrap gap-4 align-items-start">
        <partial name="_PluginIcon" model='(plugin, "lg", false)' />
        <div class="flex-grow-1 min-w-0">
            <h1 class="h3 mb-1">@plugin.Name</h1>
            <div class="text-body-secondary mb-2">
                @if (latest.VendorUrl != null) {
                    <a href="@latest.VendorUrl" target="_blank" rel="noopener noreferrer">@(plugin.Vendor ?? latest.VendorUrl)</a>
                } else {
                    @(plugin.Vendor ?? "Unknown vendor")
                }
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <code class="jp-plugin-id" id="jp-plugin-id">@plugin.Id</code>
                <button type="button" class="btn btn-sm btn-link p-0 jp-copy" data-jp-copy="#jp-plugin-id"
                        title="Copy plugin ID" aria-label="Copy plugin ID">@Icons.Render("copy")</button>
                @foreach (string tag in plugin.Tags) {
                    <a class="badge rounded-pill jp-tag" asp-page="/Index" asp-route-q="@tag">@tag</a>
                }
            </div>
            <dl class="jp-facts mb-0">
                <div><dt>Latest version</dt><dd>@latest.Version</dd></div>
                <div><dt>Compatible builds</dt><dd>@Format.BuildRange(latest.SinceBuild, latest.UntilBuild)</dd></div>
                <div><dt>Updated</dt><dd title="@Format.DateTime(latest.UploadedAt)">@Format.Date(latest.UploadedAt)</dd></div>
                <div><dt>Downloads</dt><dd>@Format.Number(Model.Downloads)</dd></div>
                <div><dt>Versions</dt><dd>@plugin.Releases.Count <span class="text-body-secondary">(@Format.Bytes(Model.TotalSize))</span></dd></div>
            </dl>
        </div>
        <div class="d-flex flex-column gap-2 jp-plugin-actions">
            <a class="btn btn-primary" href="@HttpHelpers.FileUrl(plugin.Latest)">
                @Icons.Render("download") Download @latest.Version
            </a>
            <button type="button" class="btn btn-outline-danger" data-jp-delete
                    data-jp-plugin="@plugin.Id" data-jp-name="@plugin.Name" data-jp-count="@plugin.Releases.Count">
                @Icons.Render("trash") Delete plugin
            </button>
        </div>
    </div>
    <div class="card-footer small text-body-secondary">
        @Icons.Render("info") Install from the IDE: <em>Settings | Plugins | Marketplace</em>, search for
        <strong>@plugin.Name</strong>. The IDE automatically picks the newest version compatible with it.
    </div>
</section>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview"
                type="button" role="tab" aria-controls="pane-overview" aria-selected="true">Overview</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-versions" data-bs-toggle="tab" data-bs-target="#pane-versions"
                type="button" role="tab" aria-controls="pane-versions" aria-selected="false">
            Versions <span class="badge rounded-pill text-bg-secondary ms-1">@plugin.Releases.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-dependencies" data-bs-toggle="tab" data-bs-target="#pane-dependencies"
                type="button" role="tab" aria-controls="pane-dependencies" aria-selected="false">
            Dependencies <span class="badge rounded-pill text-bg-secondary ms-1">@(Model.Dependencies.Count + Model.OptionalDependencies.Count)</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="pane-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body jp-prose">
                        @if (string.IsNullOrWhiteSpace(latest.Description)) {
                            <p class="text-body-secondary mb-0">This plugin has no description.</p>
                        } else {
                            @Model.Description
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">What's new in @latest.Version</div>
                    <div class="card-body jp-prose jp-prose-sm">
                        @if (string.IsNullOrWhiteSpace(latest.ChangeNotes)) {
                            <p class="text-body-secondary mb-0">No change notes.</p>
                        } else {
                            @Model.ChangeNotes
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pane-versions" role="tabpanel" aria-labelledby="tab-versions" tabindex="0">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 jp-table">
                    <thead>
                    <tr>
                        <th scope="col">Version</th>
                        <th scope="col">Compatible builds</th>
                        <th scope="col">Platform</th>
                        <th scope="col">Uploaded</th>
                        <th scope="col">File</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (ReleaseEntry entry in plugin.Releases) {
                        PluginRelease release = entry.Release;
                        <tr>
                            <td class="text-nowrap">
                                <span class="fw-semibold">@release.Version</span>
                                @if (entry == plugin.Latest) {
                                    <span class="badge bg-primary-subtle text-primary-emphasis ms-1">Latest</span>
                                }
                            </td>
                            <td class="text-nowrap">@Format.BuildRange(release.SinceBuild, release.UntilBuild)</td>
                            <td>
                                @if (entry.Platform.Label is { } platform) {
                                    <span class="badge jp-badge-platform">@platform</span>
                                } else {
                                    <span class="text-body-secondary">Any</span>
                                }
                            </td>
                            <td class="text-nowrap" title="@Format.DateTime(release.UploadedAt)">@Format.Date(release.UploadedAt)</td>
                            <td class="min-w-0">
                                <div class="text-truncate jp-file-name" title="@release.FileName">@release.FileName</div>
                                <div class="small text-body-secondary">
                                    @Format.Bytes(release.Size) &middot; @(release.IsJar ? "jar" : "zip") &middot;
                                    <span class="font-monospace" title="SHA-256 @release.Sha256">@release.Sha256[..12]</span>
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="@HttpHelpers.FileUrl(entry)"
                                   title="Download @release.FileName">@Icons.Render("download")<span class="visually-hidden">Download</span></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-jp-delete
                                        data-jp-plugin="@plugin.Id" data-jp-name="@plugin.Name" data-jp-version="@release.Version"
                                        title="Delete version @release.Version">@Icons.Render("trash")<span class="visually-hidden">Delete</span></button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pane-dependencies" role="tabpanel" aria-labelledby="tab-dependencies" tabindex="0">
        <div class="row g-4">
            <div class="col-lg-6">
                <partial name="_DependencyList" model="@(("Required", Model.Dependencies))" />
            </div>
            <div class="col-lg-6">
                <partial name="_DependencyList" model="@(("Optional", Model.OptionalDependencies))" />
            </div>
        </div>
        @if (latest.Modules.Count > 0) {
            <div class="card mt-4">
                <div class="card-header">Provides modules</div>
                <ul class="list-group list-group-flush">
                    @foreach (string module in latest.Modules) {
                        <li class="list-group-item"><code>@module</code></li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

<partial name="_DeleteDialog" />
